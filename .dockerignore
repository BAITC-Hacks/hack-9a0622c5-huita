# Nothing enters the build context unless explicitly allowlisted below.
**
!Dockerfile
!requirements.txt
!requirements.lock
!agent.py
!open.json
!beesmart/
!beesmart/*.py
!beesmart/agent/
!beesmart/agent/*.py
!beesmart/api/
!beesmart/api/*.py
!beesmart/application/
!beesmart/application/*.py
!organizer/
!organizer/environment.py
!organizer/scoring_core.py
!organizer/mock_environment.py
!organizer/local_eval.py
!organizer/make_submission.py
!policies/
!policies/frozen_policy.json
!static/
!static/**
# Defense in depth for nested files, including future static directories.
**/.env
**/.env.*
**/*.csv
**/*.pem
**/*.key
**/__pycache__
**/*.pyc
