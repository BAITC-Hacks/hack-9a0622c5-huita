# Safe defaults for local use. Run: python scripts/setup_env.py
# The generated .env is private, ignored by Git, and must never enter an image.
BEESMART_ENVIRONMENT=local
BEESMART_HOST=127.0.0.1
BEESMART_PORT=8000
BEESMART_API_TOKEN=
BEESMART_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Empty origins disable cross-origin browser access. List exact origins if used.
BEESMART_ALLOWED_ORIGINS=
# Empty paths use the project root/work and project root respectively.
BEESMART_STORAGE_DIR=
BEESMART_DATA_DIR=
BEESMART_FORWARDED_ALLOW_IPS=127.0.0.1
BEESMART_LOG_LEVEL=info
# Optional TLS profile: set your DNS hostname before enabling Caddy.
# BEESMART_DOMAIN=api.example.com
# OpenAI chooses pilot hypotheses; Python validates and scores campaigns.
# Put the real key only into private .env. Use provider=local for offline runs.
BEESMART_AGENT_PROVIDER=openai
OPENAI_API_KEY=
BEESMART_OPENAI_MODEL=gpt-6-luna
# Local application ledger; independent of the account balance. Maximum 50.
BEESMART_LLM_BUDGET_USD=5
